#Playbook ansible
/etc/ansible/01-web-int.yml

---
- hosts: web
  tasks:
    - name: Install nginx
      apt:
        name: nginx
        state: present
        update_cache: true

    - name: Create web root
      file:
        path: /var/www/internal
        state: directory
        mode: '0755'

    - name: Deploy index page
      copy:
        content: "This is web internal"
        dest: /var/www/internal/index.html

    - name: Configure vhost on port 8081
      copy:
        dest: /etc/nginx/sites-available/internal.conf
        content: |
          server {
              listen 8081;
              root /var/www/internal;
              index index.html;
          }
      notify: Reload nginx

    - name: Enable vhost
      file:
        src: /etc/nginx/sites-available/internal.conf
        dest: /etc/nginx/sites-enabled/internal.conf
        state: link
      notify: Reload nginx

  handlers:
    - name: Reload nginx
      service:
        name: nginx
        state: reloaded

#jalankan Ansible must 2x
ansible-playbook /etc/ansible/01-web-int.yml

