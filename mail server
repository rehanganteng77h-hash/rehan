#apache vhost /etc/apache2/sites-available/mail.conf
 
(http untuk bagian mail, https untuk bagian client di soal)
 
<VirtualHost *:80>
    ServerName mail.lksn2026.id
    DocumentRoot /var/lib/roundcube/public_html
    DirectoryIndex index.php
 
    <Directory /var/lib/roundcube/public_html>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
 
<VirtualHost *:443>
    ServerName mail.lksn2026.id
    DocumentRoot /var/lib/roundcube/public_html
    DirectoryIndex index.php
 
    SSLEngine on
    SSLCertificateFile /opt/grading/ca/mail.pem
    SSLCertificateKeyFile /opt/grading/ca/mail.key
 
    <Directory /var/lib/roundcube/public_html>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
 
