#syarat (di server lain, harus sudah jalan)

-int-srv: DNS record mail -> 172.16.1.10
-int-srv: LDAP user + grup cn=mail + overlay memberof aktif
-int-srv: CA mail.pem, mail.key, ca.pem
-fw-srv: nftables izinkan dmz-zone ke int-zone (LDAP port 389)

#login (semua di mail-srv)

su -

(pakai minus supaya PATH lengkap, kalau tidak: command not found)

#install

apt install postfix dovecot-core dovecot-imapd dovecot-ldap mailutils -y

apt install apache2 roundcube roundcube-sqlite3 -y

-Postfix: Internet Site
-System mail name: lksn2026.id
-Roundcube dbconfig-common: Yes

#sertifikat (dari int-srv)

scp /opt/grading/ca/ca.pem /opt/grading/ca/mail.pem /opt/grading/ca/mail.key r3h4ngtng@10.0.0.13:/tmp/

(10.0.0.13 = IP mgmt mail-srv, cek ip -br a)

#sertifikat (di mail-srv)

mkdir -p /opt/grading/ca

mv /tmp/ca.pem /tmp/mail.pem /tmp/mail.key /opt/grading/ca/

chown root:root /opt/grading/ca/*

chmod 600 /opt/grading/ca/mail.key

cp /opt/grading/ca/ca.pem /usr/local/share/ca-certificates/ca.crt

update-ca-certificates

#dns mail-srv /etc/resolv.conf

nameserver 192.168.1.10
search lksn2026.id

getent hosts mail.lksn2026.id

(harus keluar 172.16.1.10)

#permanen /etc/network/interfaces (di blok dmz-zone)

dns-nameservers 192.168.1.10
dns-search lksn2026.id

