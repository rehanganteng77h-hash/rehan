#postfix /etc/postfix/main.cf
 
myhostname = mail-srv.lksn2026.id
mydomain = lksn2026.id
myorigin = $mydomain
mydestination = $myhostname, lksn2026.id, localhost.lksn2026.id, localhost
home_mailbox = Maildir/
 
smtpd_tls_cert_file = /opt/grading/ca/mail.pem
smtpd_tls_key_file = /opt/grading/ca/mail.key
smtpd_tls_CAfile = /opt/grading/ca/ca.pem
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
 
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
 
newaliases
 
postfix check
 
systemctl restart postfix
 
(postfix check harus tanpa warning, kalau unused parameter = typo smtpd_)
(smtpd_tls_auth_only = login SMTP hanya boleh lewat TLS. kalau soal minta SMTP wajib TLS penuh, ganti may jadi encrypt)
 
#dovecot maildir /etc/dovecot/conf.d/10-mail.conf
 
mail_location = maildir:~/Maildir
 
#dovecot socket /etc/dovecot/conf.d/10-master.conf (di dalam service auth { })
 
  unix_listener /var/spool/postfix/private/auth {
    mode = 0666
    user = postfix
    group = postfix
  }
 
#dovecot pakai ldap /etc/dovecot/conf.d/10-auth.conf
 
#!include auth-system.conf.ext
!include auth-ldap.conf.ext
 
#dovecot /etc/dovecot/conf.d/auth-ldap.conf.ext
 
passdb {
  driver = ldap
  args = /etc/dovecot/dovecot-ldap.conf.ext
}
userdb {
  driver = ldap
  args = /etc/dovecot/dovecot-ldap.conf.ext
}
 
#dovecot ldap /etc/dovecot/dovecot-ldap.conf.ext
 
(nama file pakai strip, bukan titik)
 
uris = ldap://192.168.1.10
dn = cn=admin,dc=lksn2026,dc=id
dnpass = <password admin LDAP>
auth_bind = yes
base = ou=mail,dc=lksn2026,dc=id
pass_filter = (uid=%u)
user_filter = (uid=%u)
user_attrs = homeDirectory=home,uidNumber=uid,gidNumber=gid
 
chmod 600 /etc/dovecot/dovecot-ldap.conf.ext
 
(base ou=mail = hanya user di ou=mail yang bisa login, vpn1-3 otomatis ditolak)
(jangan pakai auth_bind_userdn, filter jadi diabaikan)
 
#dovecot tls /etc/dovecot/conf.d/10-ssl.conf
 
ssl = required
ssl_cert = </opt/grading/ca/mail.pem
ssl_key = </opt/grading/ca/mail.key
 
(tanda < di depan path wajib)
 
