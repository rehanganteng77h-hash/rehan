#install
apt install slapd ldap-utils -y
dpkg-reconfigure slapd
-DNS domain name: lksn2026.id
-Organization name: ITNSA
-Database backend: MDB
-Base DN otomatis: dc=lksn2026,dc=id

#Struktur
dc=lksn2026,dc=id
├── ou=People          (semua user, flat — tidak dibagi per OU fungsi)
│   ├── uid=ani
│   ├── uid=kyw1..kyw5
│   └── uid=vpn1..vpn3
└── ou=Groups           (keanggotaan/akses dikontrol via Group, bukan lokasi OU)
    ├── cn=mail          (5 member: ani, kyw1-5)
    └── cn=vpn            (4 member: ani, vpn1-3)

